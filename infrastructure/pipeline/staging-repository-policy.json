{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PipelineBuildPushesReleaseImages",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::DEPLOYMENT_ACCOUNT:root"},
      "Action": ["ecr:DescribeImages", "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Condition": {"StringEquals": {"aws:PrincipalArn": "arn:aws:iam::DEPLOYMENT_ACCOUNT:role/sendrec-pipeline-build"}}
    },
    {
      "Sid": "PipelinePromoteReadsReleaseImages",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::DEPLOYMENT_ACCOUNT:root"},
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Condition": {"StringEquals": {"aws:PrincipalArn": "arn:aws:iam::DEPLOYMENT_ACCOUNT:role/sendrec-pipeline-promote"}}
    }
  ]
}
