# Base image with slow-changing dependencies: whisper.cpp, ffmpeg, RNNoise model.
# Rebuild only when whisper version or system deps change.
# MPD builds this itself and pushes it to the staging account's ECR repository
# sendrec-base; Dockerfile pins the pushed digest. See infrastructure/README.md.
# Build it from the repository root, which holds scripts/check-ca-roots.sh.

# Stage 1: Build whisper.cpp
FROM alpine:3.21 AS whisper
RUN apk add --no-cache build-base cmake git
WORKDIR /build
ARG WHISPER_VERSION=v1.8.3
# GGML_NATIVE=OFF builds for any x86-64 CPU with AVX2, FMA and F16C, which every
# Fargate host has. Tuning for the build host's CPU, such as AVX-512, would crash
# whisper-cli on a host without it.
RUN git clone --depth 1 --branch ${WHISPER_VERSION} https://github.com/ggerganov/whisper.cpp.git . && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DGGML_NATIVE=OFF && \
    cmake --build build --target whisper-cli -j$(nproc)

# Stage 2: Final base image
FROM alpine:3.21
RUN apk add --no-cache ca-certificates ffmpeg libstdc++
RUN addgroup -S sendrec && adduser -S sendrec -G sendrec
WORKDIR /app
COPY --from=whisper /build/build/bin/whisper-cli /usr/local/bin/whisper-cli
RUN mkdir -p /app/models && \
    wget -q -O /app/models/std.rnnn https://github.com/richardpl/arnndn-models/raw/master/std.rnnn
RUN --mount=type=bind,source=scripts/check-ca-roots.sh,target=/tmp/check-ca-roots.sh sh /tmp/check-ca-roots.sh
